# ─────────────────────────────────────────────────────────────
#  Supabase — Dashboard > Project Settings > API 에서 복사
# ─────────────────────────────────────────────────────────────

# 브라우저에 노출되는 공개 값. anon 키는 RLS 로 보호되므로 노출되어도 안전하다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠ 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것. 서버 라우트에서만 사용한다.
#   RLS 를 우회하므로 유출되면 전체 데이터가 노출된다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─────────────────────────────────────────────────────────────
#  관리자 인증
# ─────────────────────────────────────────────────────────────

# bcrypt 해시. 생성:  npm run hash-password -- '원하는비밀번호'
# ⚠ 해시에 $ 가 들어가므로 반드시 작은따옴표로 감쌀 것 (감싸지 않으면 $2a 등이 변수로 치환된다)
ADMIN_PASSWORD_HASH='$2a$10$........................................................'

# 위 해시를 설정하지 않은 경우에만 사용되는 평문 폴백 (로컬 개발용).
# 운영에서는 반드시 ADMIN_PASSWORD_HASH 를 쓸 것.
# ADMIN_PASSWORD=

# 관리자 세션 쿠키 서명용 시크릿. 32자 이상이어야 하며, 아래 명령으로 생성한다.
#   openssl rand -base64 48
# ⚠ 비워두거나 플레이스홀더(change-me / example / placeholder 등)를 남기면
#   관리자 인증이 기동 즉시 실패한다. 기본값을 그대로 쓰면 쿠키가 위조된다.
ADMIN_SESSION_SECRET=

# 관리자 세션 유효 시간(시간 단위). 미설정 시 8시간.
# ADMIN_SESSION_HOURS=8

# ─────────────────────────────────────────────────────────────
#  동시성 부하 테스트 (scripts/load-test.mjs) 전용
#  ⚠ 데이터를 초기화하므로 반드시 개발용 Supabase 프로젝트를 가리킬 것.
# ─────────────────────────────────────────────────────────────
# LOAD_TEST_ALLOW=1
